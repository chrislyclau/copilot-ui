{
    "name": "react-example",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "tsx server.entry.ts",
        "build": "vite build && esbuild server.entry.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
        "start": "node dist/server.cjs",
        "lint": "tsc --noEmit -p tsconfig.json && eslint . && tsx scripts/check-explicit-any.ts",
        "diagnose:gates": "tsx scripts/diagnose-gates.ts",
        "review:pr": "tsx scripts/review-pr.ts",
        "agent:issue": "tsx scripts/run-issue-task.ts",
        "agent:audit": "tsx scripts/audit-codebase.ts",
        "agent:code-change": "tsx scripts/code-change-agent.ts",
        "agent:code-change-open": "tsx scripts/code-change-agent-open.ts",
        "import:repo": "tsx scripts/import-repo.ts",
        "diff:repo": "tsx scripts/remote-diff.ts",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@github/copilot-sdk": "^1.0.13",
        "@google/genai": "^2.22.0",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-react": "^5.2.0",
        "better-sqlite3": "^12.11.1",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^4.22.3",
        "lucide-react": "^0.546.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-markdown": "^10.1.0",
        "tailwindcss": "^4.3.1",
        "vite": "^6.4.3"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/better-sqlite3": "^7.6.13",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/node": "^22.20.2",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@vitest/coverage-v8": "^4.1.9",
        "adm-zip": "^0.6.1",
        "autoprefixer": "^10.6.1",
        "esbuild": "^0.25.12",
        "eslint": "^10.10.0",
        "node-forge": "^1.4.0",
        "openai": "^6.49.0",
        "tsx": "^4.23.13",
        "typescript": "^5.9.3",
        "vite": "^6.4.3",
        "vitest": "^4.1.9",
        "yaml": "^2.9.1"
    }
}
